# ============================================================
#  HustleHub+ API — Environment Variables (TEMPLATE)
# ------------------------------------------------------------
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real .env — it is gitignored.
#  Each team member creates their own local .env.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (get from Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hustlehub?retryWrites=true&w=majority

# JWT signing secret — use a long random string (see README for how to generate)
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=1h

# HTTPS local SSL certificate paths (generated locally — see README)
SSL_KEY_PATH=./ssl/key.pem
SSL_CERT_PATH=./ssl/cert.pem
